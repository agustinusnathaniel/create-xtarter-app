{
  "name": "create-xtarter-app",
  "version": "1.1.0",
  "description": "Fast project scaffolding for modern web apps",
  "author": "agustinusnathaniel",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-xtarter-app": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "start": "node dist/cli.mjs",
    "type-check": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "check:all": "turbo run type-check test ultracite:check",
    "prepublishOnly": "turbo run build",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "release": "commit-and-tag-version",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "giget": "^3.2.0",
    "tinyexec": "^1.0.4",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "commit-and-tag-version": "^12.7.1",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2",
    "ultracite": "7.4.0",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  },
  "engines": {
    "node": "^24.11.x"
  },
  "packageManager": "pnpm@10.26.2",
  "keywords": [
    "scaffold",
    "starter",
    "template",
    "cli",
    "nextjs",
    "vite",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agustinusnathaniel/create-xtarter-app"
  },
  "bugs": {
    "url": "https://github.com/agustinusnathaniel/create-xtarter-app/issues"
  },
  "homepage": "https://github.com/agustinusnathaniel/create-xtarter-app#readme",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
