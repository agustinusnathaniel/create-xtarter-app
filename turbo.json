{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["type-check", "test"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsdown.config.*", "package.json"]
    },
    "type-check": {
      "outputs": ["*.tsbuildinfo"],
      "inputs": ["src/**", "tsconfig.json"]
    },
    "ultracite:check": {
      "outputs": [],
      "inputs": ["biome.json", "src/**"]
    },
    "test": {
      "outputs": [],
      "inputs": ["vitest.config.ts", "src/**"]
    }
  }
}
